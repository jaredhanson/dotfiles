# Per-terminal shell history for Rex.
#
# Rex restores every session, window, and block after its server restarts,
# starting a fresh shell in each block with the same REX_BLOCK it had before.
# A fresh shell has no memory of its own, so this fragment gives each block
# its own history file, named by that ID, and writes every command to it
# immediately.  A restored block then picks up exactly where its predecessor
# left off, and a killed shell loses nothing.
#
# Files are keyed by block alone.  A window can move to another session, so a
# block's session isn't stable, and Rex no longer sets REX_SESSION.
#
# Outside Rex, where REX_BLOCK is unset, nothing here takes effect.

if [[ -n $REX_BLOCK ]]; then
  # The history file the shell would otherwise use, as set by /etc/zshrc or
  # earlier configuration, kept before HISTFILE is pointed at the block's own
  # file.  It remains the cross-session index: new blocks seed from it and,
  # with mirroring on, every command is copied to it.  The mirror hook reads
  # it on every command, so it stays global.
  typeset -g ORIG_HISTFILE=${HISTFILE:-$HOME/.zsh_history}

  # Whether to copy each command to ORIG_HISTFILE as well.  Set it to 0
  # before this fragment loads to keep history strictly per block.
  : ${REX_MIRROR_HISTORY:=1}

  # Set up in an anonymous function so the path pieces stay local; only
  # HISTFILE and the options need to outlive it.
  () {
    # One file per block.
    local dir=${XDG_STATE_HOME:-$HOME/.local/state}/rex/history
    local file=$dir/${REX_BLOCK#block:}

    mkdir -p -m 700 "$dir"

    # A new block starts with the history of its neighbors, so that a fresh
    # split isn't empty.  Rex is asked once which blocks share the session,
    # and their files are read oldest first, so the most recent sibling's
    # commands are nearest in the history.  If Rex can't answer, or no
    # sibling has history yet, the original file is read instead.  The seed
    # is read into memory only; the block's own file holds just what is
    # typed here.
    if [[ ! -e $file ]]; then
      local -a siblings seeds
      local line
      for line in ${(f)"$(rex --timeout 2s block ls -s "$REX_BLOCK" --json 2>/dev/null)"}; do
        [[ $line == *'"block_id":'*'"block:'* ]] || continue
        line=${line##*\"block:}
        siblings+=(${line%%\"*})
      done
      local candidate
      for candidate in "$dir"/*(.NOm); do
        (( ${siblings[(Ie)${candidate:t}]} )) && seeds+=("$candidate")
      done
      (( $#seeds )) || seeds=("$ORIG_HISTFILE"(.N))
      local seed
      for seed in $seeds; do
        fc -R "$seed"
      done
    fi

    HISTFILE=$file
    HISTSIZE=50000
    SAVEHIST=50000
  }

  # Write each command to the file as soon as it finishes, with its timestamp
  # and duration, rather than when the shell exits.  Rex ends shells without
  # warning when its server stops, so writing at exit would lose the most
  # recent commands.
  setopt INC_APPEND_HISTORY_TIME
  setopt EXTENDED_HISTORY
  setopt HIST_FCNTL_LOCK
  unsetopt SHARE_HISTORY

  # Copy each command to the original file in the same format zsh writes, so
  # it stays a complete, searchable record across sessions and non-Rex
  # shells.
  if (( REX_MIRROR_HISTORY )); then
    rex_mirror_history() {
      local nl=$'\n' line=${1%$'\n'}
      [[ -n $line ]] || return 0
      # zsh continues a multi-line entry by ending each line with a backslash.
      print -r -- ": ${EPOCHSECONDS:-$(date +%s)}:0;${line//$nl/\\$nl}" >> "$ORIG_HISTFILE"
      return 0
    }
    zmodload -F zsh/datetime p:EPOCHSECONDS 2>/dev/null
    autoload -Uz add-zsh-hook
    add-zsh-hook zshaddhistory rex_mirror_history
  fi
fi
